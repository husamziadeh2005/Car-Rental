@model Payment

@{
    ViewData["Title"] = "New Payment";
}

<div class="page-header">
    <div>
        <h1>New Payment</h1>
        <p class="page-subtitle">Record a payment against a rental.</p>
    </div>
</div>

<div class="section-card">
    <div class="section-card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">
                <div>
                    <label asp-for="RentalId" class="form-label"></label>
                    <select asp-for="RentalId" class="form-select" asp-items="ViewBag.Rentals">
                        <option value="">Select a rental…</option>
                    </select>
                    <span asp-validation-for="RentalId" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" class="form-control" placeholder="e.g. 150" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="PaymentDate" class="form-label"></label>
                    <input asp-for="PaymentDate" class="form-control" />
                    <span asp-validation-for="PaymentDate" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <input asp-for="PaymentMethod" class="form-control" placeholder="e.g. credit card" />
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="PaymentStatus" class="form-label"></label>
                    <input asp-for="PaymentStatus" class="form-control" placeholder="e.g. paid" />
                    <span asp-validation-for="PaymentStatus" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Payment</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
