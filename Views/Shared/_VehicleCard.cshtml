@model Vehicle

<div class="col-sm-6 col-lg-4">
    <div class="entity-card">

        <div class="entity-media">
            <a asp-controller="Vehicles"
               asp-action="Details"
               asp-route-id="@Model.VehicleId">

                @if (Model.Brand == "Toyota" && Model.Model == "Corolla")
                {
                    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/2024_Toyota_Corolla_LE.jpg"
                         alt="Toyota Corolla"
                         class="img-fluid w-100">
                }
                else if (Model.Brand == "Hyundai" && Model.Model == "Santa Fe")
                {
                    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/2025_Hyundai_Santa_Fe.jpg"
                         alt="Hyundai Santa Fe"
                         class="img-fluid w-100">
                }
                else if (Model.Brand == "BMW" && Model.Model == "520i")
                {
                    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/BMW_520i_(1).jpg"
                         alt="BMW 520i"
                         class="img-fluid w-100">
                }
                else if (Model.Brand == "Toyota" && Model.Model == "Hiace")
                {
                    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Toyota_Hiace_(48235305401).jpg"
                         alt="Toyota Hiace"
                         class="img-fluid w-100">
                }
                else if (Model.Brand == "Porsche" && Model.Model == "911")
                {
                    <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Porsche_911.jpg"
                         alt="Porsche 911"
                         class="img-fluid w-100">
                }

            </a>
        </div>

        <div class="entity-body">

            <div class="d-flex justify-content-between align-items-start">
                <h5 class="entity-title">
                    @Model.Brand @Model.Model
                </h5>

                <partial name="_VehicleStatusBadge"
                         model="Model.VehicleType" />
            </div>

            <div class="entity-meta">

                <span>
                    @Model.Year
                    @(Model.Category != null
                        ? "· " + Model.Category.Name
                        : "")
                </span>

                <span>
                    Plate: @Model.LicensePlate
                </span>

            </div>

            <div class="entity-price mt-1">
                @Model.DailyRate.ToString("C")

                <span class="fs-6 fw-normal text-body-secondary">
                    / day
                </span>
            </div>

        </div>

        <div class="entity-footer">

            <a asp-controller="Vehicles"
               asp-action="Details"
               asp-route-id="@Model.VehicleId"
               class="btn btn-outline-primary btn-sm flex-fill">
                View Details
            </a>

        </div>

    </div>
</div>