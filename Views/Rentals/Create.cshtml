@model Rental

@{
    ViewData["Title"] = "New Rental";
}

<div class="page-header">
    <div>
        <h1>New Rental</h1>
        <p class="page-subtitle">Book a vehicle for a customer.</p>
    </div>
</div>

<div class="section-card">
    <div class="section-card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">
                <div>
                    <label asp-for="CustomerId" class="form-label"></label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                        <option value="">Select a customer…</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="VehicleId" class="form-label"></label>
                    <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.Vehicles">
                        <option value="">Select a vehicle…</option>
                    </select>
                    <span asp-validation-for="VehicleId" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="TotalPrice" class="form-label"></label>
                    <input asp-for="TotalPrice" class="form-control" placeholder="e.g. 150" />
                    <span asp-validation-for="TotalPrice" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<EnumRentalStatus>()"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Rental</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
